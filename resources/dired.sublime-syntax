%YAML 1.2
---
name: dired
hidden: true
file_extensions:
  - dired
scope: text.dired
contexts:
  main:
    # The three variants below recolor the item name when the stats column
    # carries the Windows hidden/system attribute flags (HS|H-|-S|--).
    # The fileattr scope needs to be appended AFTER the base name scope.
    # Match patterns include the Separator \x{2063} as defined in dired.py (STATS_SEP)
    - match: '^(?=.*\x{200B}.*\x{2063}\s*HS$)(\s*)([▸▾] )([^\/]*?)([/\\])?\s*(<.*>)?(\s*\x{200B}(.*))?$'
      scope: dired.item.directory
      captures:
        1: indent
        2: punctuation.definition.directory.symbol.dired
        3: string.name.directory.dired dired.fileattr.hidden dired.fileattr.system
        4: punctuation.definition.directory.slash.dired dired.fileattr.hidden dired.fileattr.system
        5: string.error.dired
        6: string.name.directory.stats.dired
    - match: '^(?=.*\x{200B}.*\x{2063}\s*H-$)(\s*)([▸▾] )([^\/]*?)([/\\])?\s*(<.*>)?(\s*\x{200B}(.*))?$'
      scope: dired.item.directory
      captures:
        1: indent
        2: punctuation.definition.directory.symbol.dired
        3: string.name.directory.dired dired.fileattr.hidden
        4: punctuation.definition.directory.slash.dired dired.fileattr.hidden
        5: string.error.dired
        6: string.name.directory.stats.dired
    - match: '^(?=.*\x{200B}.*\x{2063}\s*-S$)(\s*)([▸▾] )([^\/]*?)([/\\])?\s*(<.*>)?(\s*\x{200B}(.*))?$'
      scope: dired.item.directory
      captures:
        1: indent
        2: punctuation.definition.directory.symbol.dired
        3: string.name.directory.dired dired.fileattr.system
        4: punctuation.definition.directory.slash.dired dired.fileattr.system
        5: string.error.dired
        6: string.name.directory.stats.dired
        
    - match: '^(\s*)([▸▾] )([^\/]*?)([/\\])?\s*(<.*>)?(\s*\x{200B}(.*))?$'
      scope: dired.item.directory
      captures:
        1: indent
        2: punctuation.definition.directory.symbol.dired
        3: string.name.directory.dired
        4: punctuation.definition.directory.slash.dired
        5: string.error.dired
        6: string.name.directory.stats.dired
    - match: '^(?=.*\x{200B}.*\x{2063}\s*HS$)(\s*)(≡ )(.*?(\.[^\.\n]+?)?)(\s*\x{200B}(.*))?$'
      scope: dired.item.file
      captures:
        1: indent
        2: punctuation.definition.file.symbol.dired
        3: string.name.file.dired dired.fileattr.hidden dired.fileattr.system
        4: string.name.file.extension.dired dired.fileattr.hidden dired.fileattr.system
        5: string.name.file.stats.dired
    - match: '^(?=.*\x{200B}.*\x{2063}\s*H-$)(\s*)(≡ )(.*?(\.[^\.\n]+?)?)(\s*\x{200B}(.*))?$'
      scope: dired.item.file
      captures:
        1: indent
        2: punctuation.definition.file.symbol.dired
        3: string.name.file.dired dired.fileattr.hidden
        4: string.name.file.extension.dired dired.fileattr.hidden
        5: string.name.file.stats.dired
    - match: '^(?=.*\x{200B}.*\x{2063}\s*-S$)(\s*)(≡ )(.*?(\.[^\.\n]+?)?)(\s*\x{200B}(.*))?$'
      scope: dired.item.file
      captures:
        1: indent
        2: punctuation.definition.file.symbol.dired
        3: string.name.file.dired dired.fileattr.system
        4: string.name.file.extension.dired dired.fileattr.system
        5: string.name.file.stats.dired
    - match: '^(\s*)(≡ )(.*?(\.[^\.\n]+?)?)(\s*\x{200B}(.*))?$'
      scope: dired.item.file
      captures:
        1: indent
        2: punctuation.definition.file.symbol.dired
        3: string.name.file.dired
        4: string.name.file.extension.dired
        5: string.name.file.stats.dired
    - match: '^⠤(\s*\[.+\]){0,1}$'
      scope: dired.item.parent_dir
      captures:
        1: punctuation.definition.rename_mode.dired
    - match: '\S(.*?)(\[.+)?$'
      captures:
        0: header.dired
        2: keyword.control.filtered.dired
      push:
        - meta_scope: header.dired
        - match: '^(—+)(\[RENAME MODE\]){0,1}(—*)\n'
          captures:
            1: punctuation.definition.separator.dired
            2: punctuation.definition.rename_mode.dired
            3: punctuation.definition.separator.dired
          pop: true
